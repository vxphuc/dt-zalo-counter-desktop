{
  "name": "dt-zalo-counter-assistant",
  "version": "1.0.4",
  "description": "DT Zalo CRM - Trợ lý Mini Game tại quầy",
  "author": "DT Group",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/package.cjs win --x64",
    "build:win": "node scripts/package.cjs win",
    "build:mac": "node scripts/package.cjs mac",
    "build:linux": "node scripts/package.cjs linux",
    "checksums": "node scripts/checksums.cjs",
    "prepare-release": "node scripts/prepare-release.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "vn.dtzalobe.counter",
    "productName": "DT Zalo - Tro ly tai quay",
    "directories": {
      "output": "../output/desktop-assistant"
    },
    "files": [
      "main.cjs",
      "window-policy.cjs",
      "platform-support.cjs",
      "update-controller.cjs",
      "update-policy.json",
      "preload.cjs",
      "bubble.html",
      "bubble.css",
      "bubble.js",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "DT-Zalo-Counter-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/256x256.png",
      "category": "Office",
      "maintainer": "DT Group",
      "executableName": "dt-zalo-counter",
      "artifactName": "DT-Zalo-Counter-${version}-Linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "DT-Zalo-Counter-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
