{
  "name": "dt-zalo-counter-assistant",
  "version": "1.0.12",
  "description": "Tro Ly App - Trợ lý Mini Game tại quầy",
  "author": "DT Group",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs win --x64",
    "build:win": "node scripts/build.cjs win",
    "build:mac": "node scripts/build.cjs mac",
    "checksums": "node scripts/checksums.cjs",
    "publish:vps": "node scripts/publish-release.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "vn.dtzalobe.counter",
    "productName": "Tro Ly App",
    "directories": {
      "output": "../output/desktop-assistant"
    },
    "files": [
      "main.cjs",
      "window-policy.cjs",
      "platform-support.cjs",
      "preload.cjs",
      "bubble.html",
      "bubble.css",
      "bubble.js",
      "assets/**",
      "updates.cjs",
      "update-contract.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": true,
      "executableName": "DT Zalo - Tro ly tai quay"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "DT-Zalo-Counter-${version}-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "DT-Zalo-Counter-Setup-${version}.${ext}",
      "shortcutName": "Tro Ly App"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "js-yaml": "4.3.2",
    "semver": "7.7.3"
  }
}
